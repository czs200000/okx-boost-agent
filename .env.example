MAKER_SELL_TRIGGER_BPS=3
MAKER_FAST_EXIT_TRIGGER_BPS=2
MAKER_STOP_LOSS_BPS=15
MAKER_TARGET_GAIN_BPS=10
MAKER_MAX_HOLD_MS=1200000
MAKER_ORDER_TTL_MS=15000
MAKER_MAX_INVENTORY_USD=480
MAKER_PRICE_DRIFT_GUARD_BPS=25
MAKER_PRICE_JUMP_GUARD_BPS=60
MAKER_TREND_WINDOW_MS=300000
MAKER_TREND_PAUSE_BPS=50
MAKER_REGIME_WINDOW_MS=7200000
MAKER_REGIME_TREND_BPS=50
MAKER_REGIME_RANGE_MAX_BPS=300
MAKER_REGIME_MIN_SAMPLES=30
MAKER_BREAKER_AUTO_RESUME=true

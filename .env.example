# Conservative public defaults. Increase only after testing live liquidity.
TOTAL_CAPITAL_USD=200
MAX_TRADE_USD=50
MIN_DYNAMIC_TRADE_USD=10
MAX_TRADE_NVDA_USD=50
MAX_TRADE_SNDK_USD=50
MAX_TRADE_SPCX_USD=0
MAX_TRADE_CRCL_USD=0
MAX_TRADE_SKHY_USD=0
MAX_TOTAL_RWA_EXPOSURE_PCT=80
MAX_TOKEN_POSITION_PCT=80
MAX_SLIPPAGE_BPS=15
MIN_BROADCAST_INTERVAL_MS=60000
DAILY_LOSS_LIMIT_PCT=0
MAX_TRADES_PER_HOUR=0

# AEON (BNB Chain) trading competition module — independent from X Layer RWA.
# The AEON bot trades AEON/USDT on BNB Chain through OKX DEX and gates entries
# on live BSC gas cost so the 0-loss goal survives network fee spikes.
AEON_ENABLED=false
AEON_AUTONOMOUS_ENABLED=true
# Set to true only after the wallet is registered on the AEON Boost page.
AEON_ATTRIBUTION_VERIFIED=false
AEON_CYCLE_MS=30000
AEON_MARKET_POLL_MS=15000
AEON_POSITION_MONITOR_MS=20000
AEON_MAX_TRADE_USD=150
AEON_MAX_EXPOSURE_USD=400
AEON_ENTRY_DIP_BPS=30
AEON_EXIT_GAIN_BPS=100
AEON_STOP_LOSS_BPS=200
AEON_GRID_SPACING_BPS=60
AEON_MAX_GRID_LOTS=1
AEON_MAX_OPEN_LOTS=1
AEON_MIN_ENTRY_NET_EDGE_BPS=15
AEON_MIN_BID_TREND_BPS=-5
AEON_MIN_SELL_NET_EXIT_BPS=20
AEON_MAX_ROUND_TRIP_LOSS_BPS=40
AEON_MAX_EXECUTION_COST_BPS=100
AEON_MAX_QUOTE_AGE_MS=90000
AEON_MIN_SAMPLES=3
AEON_SAMPLE_WINDOW=24
AEON_MIN_BROADCAST_INTERVAL_MS=20000
AEON_MAX_SLIPPAGE_BPS=20
AEON_MAX_GAS_PRICE_GWEI=8
AEON_MAX_GAS_COST_USD_PER_SWAP=1.0
AEON_MAX_CAMPAIGN_COSTS_USD=50
AEON_MAX_LOSS_USD=20
AEON_TARGET_VOLUME_USD=50000
AEON_INITIAL_VOLUME_USD=0
AEON_LEADERBOARD_ROWS=20

# Maker rotation (X Layer RWA / NVDAx) — one token, strict buy/sell
# alternation with short-life limit triggers around mid. Modeled on the
# top-200 leaderboard pattern. Keep MAX_TRADE_NVDA_USD=0 so the dip strategy
# does not fight the maker module for the same token.
MAKER_ENABLED=true
MAKER_AUTONOMOUS_ENABLED=true
MAKER_MODE=grid
MAKER_CYCLE_MS=12000
MAKER_TOKEN=NVDAx
MAKER_TOKEN_ADDRESS=0xc845b2894dbddd03858fd2d643b4ef725fe0849d
MAKER_QUOTE_ADDRESS=0x779ded0c9e1022225f8e0630b35a9b54be713736

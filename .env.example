MEDIUM_SIZE_NET_ENTRY_BPS=0.5
SMALL_SIZE_NET_ENTRY_BPS=0.5
MIN_NET_EXIT_BPS=2
TOKEN_LOSS_STREAK_LIMIT=2
TOKEN_COOLDOWN_MINUTES=60
MAX_GRID_LOTS_PER_TOKEN=4
MAX_OPEN_GRID_LOTS=20
EXECUTABLE_QUOTE_MIN_SAMPLES=3
EXECUTABLE_QUOTE_WINDOW_SAMPLES=24
NVDA_ENTRY_SIGNAL_BPS=1
SNDK_ENTRY_SIGNAL_BPS=15
SPCX_ENTRY_SIGNAL_BPS=10
CRCL_ENTRY_SIGNAL_BPS=15
SKHY_ENTRY_SIGNAL_BPS=10

PORT=4310
ONCHAINOS_CLI=onchainos

# Optional AI advisor. The deterministic strategy remains authoritative.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Safe defaults: no real trades until all three values are deliberately enabled.
EXECUTION_MODE=paper
AUTONOMOUS_ENABLED=false
BOOST_ATTRIBUTION_VERIFIED=false
BOOST_TARGET_VOLUME_USD=650
BOOST_INITIAL_VOLUME_USD=0

# Strategy timing and signals.
AUTONOMOUS_CYCLE_MS=60000
MARKET_POLL_MS=30000
POSITION_MONITOR_MS=30000
AI_ANALYSIS_INTERVAL_MS=120000
ADAPTIVE_TIMING_ENABLED=true
ADAPTIVE_EVALUATION_MS=3600000
PRICE_WINDOW_SAMPLES=48
MAX_CAMPAIGN_COSTS_USD=10
MIN_SIGNAL_BPS=5
MAX_ENTRY_DOWNTREND_BPS=5
MAX_POSITION_MINUTES=10
TAKE_PROFIT_BPS=10
STOP_LOSS_BPS=20
HARD_STOP_LOSS_BPS=40
RECOVERY_MAX_MINUTES=30

# Quote and economics gates (basis points).
MAX_EXECUTION_COST_BPS=150
MAX_EFFECTIVE_COST_BPS=5
MAX_REWARD_SUBSIDY_BPS=150
MIN_NET_EDGE_BPS=1
MAX_ROUND_TRIP_LOSS_BPS=15
MAX_ENTRY_ROUND_TRIP_LOSS_BPS=12
MIN_ENTRY_EFFICIENCY_BPS=0.5
MIN_GRID_LAYER_SPACING_BPS=3
MAX_EXECUTABLE_QUOTE_AGE_MS=90000
OFF_HOURS_MAX_TRADE_USD=50
EXTENDED_HOURS_EXTRA_EDGE_BPS=2
CLOSED_HOURS_EXTRA_EDGE_BPS=4

PORT=4310
ONCHAINOS_CLI=onchainos

# Optional AI advisor. The deterministic strategy remains authoritative.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Safe defaults: no real trades until all three values are deliberately enabled.
EXECUTION_MODE=paper
AUTONOMOUS_ENABLED=false
BOOST_ATTRIBUTION_VERIFIED=false
BOOST_TARGET_VOLUME_USD=650
BOOST_INITIAL_VOLUME_USD=0

# Strategy timing and signals.
AUTONOMOUS_CYCLE_MS=60000
MARKET_POLL_MS=30000
POSITION_MONITOR_MS=30000
AI_ANALYSIS_INTERVAL_MS=120000
ADAPTIVE_TIMING_ENABLED=true
ADAPTIVE_EVALUATION_MS=3600000
PRICE_WINDOW_SAMPLES=48
MAX_CAMPAIGN_COSTS_USD=10
MIN_SIGNAL_BPS=5
MAX_ENTRY_DOWNTREND_BPS=5
MAX_POSITION_MINUTES=10
TAKE_PROFIT_BPS=10
STOP_LOSS_BPS=20
HARD_STOP_LOSS_BPS=40
RECOVERY_MAX_MINUTES=30

# Quote and economics gates (basis points).
MAX_EXECUTION_COST_BPS=150
MAX_EFFECTIVE_COST_BPS=5
MAX_REWARD_SUBSIDY_BPS=150
MIN_NET_EDGE_BPS=1
MAX_ROUND_TRIP_LOSS_BPS=15
MIN_NET_ENTRY_BPS=10
MEDIUM_SIZE_NET_ENTRY_BPS=6
SMALL_SIZE_NET_ENTRY_BPS=3
MIN_NET_EXIT_BPS=10
TOKEN_LOSS_STREAK_LIMIT=2
TOKEN_COOLDOWN_MINUTES=60
EXECUTABLE_QUOTE_MIN_SAMPLES=3
EXECUTABLE_QUOTE_WINDOW_SAMPLES=24
NVDA_ENTRY_SIGNAL_BPS=1
SNDK_ENTRY_SIGNAL_BPS=30
MAX_PROJECTED_LOSS_PER_TRADE_USD=0.75

# Conservative public defaults. Increase only after testing live liquidity.
TOTAL_CAPITAL_USD=200
MAX_TRADE_USD=50
MIN_DYNAMIC_TRADE_USD=10
MAX_TRADE_NVDA_USD=50
MAX_TRADE_SNDK_USD=50
MAX_TRADE_SPCX_USD=0
MAX_TOTAL_RWA_EXPOSURE_PCT=80
MAX_TOKEN_POSITION_PCT=80
MAX_SLIPPAGE_BPS=15
MIN_BROADCAST_INTERVAL_MS=60000
DAILY_LOSS_LIMIT_PCT=0
MAX_TRADES_PER_HOUR=0
